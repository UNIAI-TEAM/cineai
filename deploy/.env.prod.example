# ── /opt/ai_movie 专用 Postgres + Redis（勿与 kepu 共用）────────
POSTGRES_USER=printfilm
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=printfilm
POSTGRES_PORT=15432
REDIS_PORT=16379

SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgresql+asyncpg://printfilm:change-me-strong-db-password@127.0.0.1:15432/printfilm
DATABASE_URL_SYNC=postgresql+psycopg2://printfilm:change-me-strong-db-password@127.0.0.1:15432/printfilm
# API 连接池（uvicorn 建议 --workers 1）；Worker unit 设 PRINTFILM_DB_ROLE=celery
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_SIZE_CELERY=2
DB_MAX_OVERFLOW_CELERY=3
REDIS_URL=redis://127.0.0.1:16379/0

PUBLIC_BASE_URL=https://your-site.example.com
CORS_ORIGINS=https://your-site.example.com,https://admin.your-site.example.com
# 真实生产域名见本机 backend/.env.secrets.local（勿提交）
# ADMIN_BOOTSTRAP_EMAILS=admin@example.com

ARK_MOCK=false
# 直连 OpenAI + BytePlus ModelArk（两个不同上游，各自的 Key；也可只在管理后台「系统设置 → 模型」填写，见 docs/PROVIDERS.md）
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_LLM=gpt-5.6-sol

ARK_API_KEY=your-byteplus-modelark-api-key
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3

USE_CELERY=true
QUOTA_ENABLED=false

BILLING_ENABLED=true
BILLING_MARKUP=1.0
BILLING_SIGNUP_GRANT_FEN=500
# 展示货币与银行转账收款（也可在管理后台填写）
BILLING_DISPLAY_CURRENCY=VND
BILLING_CNY_VND=3600
TOPUP_BANK_NAME=
TOPUP_BANK_ACCOUNT=
TOPUP_BANK_HOLDER=
TOPUP_BANK_BIN=
TOPUP_ORDER_EXPIRE_HOURS=24

CELERY_AUTOSCALE_MIN=1
CELERY_AUTOSCALE_MAX=3
CELERY_WORKER_QUEUES=drama,oss,video,pipeline
