# Docker 全栈环境变量（复制为 deploy/.env.docker 后修改）
# 用法：docker compose --env-file deploy/.env.docker -f docker-compose.yml up -d

POSTGRES_USER=printfilm
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=printfilm

SECRET_KEY=change-me-to-a-long-random-string

# 用户端 nginx :9090；管理端 :9091；API 文档 :8000
CORS_ORIGINS=http://localhost:9090,http://127.0.0.1:9090,http://localhost:9091,http://127.0.0.1:9091,http://localhost:8000,http://127.0.0.1:8000
PUBLIC_BASE_URL=http://localhost:9090

# 启动后将已注册邮箱提权为管理员（逗号分隔，不造号）
# ADMIN_BOOTSTRAP_EMAILS=you@example.com

ARK_MOCK=false
# 直连 OpenAI + BytePlus ModelArk（两个不同上游，各自的 Key；也可在管理后台「系统设置 → 模型」填写，见 docs/PROVIDERS.md）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_LLM=gpt-5.6-sol
ARK_API_KEY=
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
MODEL_IMAGE=dola-seedream-5-0-pro-260628
MODEL_VIDEO=dreamina-seedance-2-5-260628

BILLING_ENABLED=false
BILLING_MARKUP=1.0
BILLING_SIGNUP_GRANT_FEN=500
BILLING_USD_CNY=7.0

OSS_ENABLED=false
